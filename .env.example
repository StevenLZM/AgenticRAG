# Copy this file to .env.local and fill in real credentials.
# Load it before starting the app:
#   set -a; source .env.local; set +a

AGENTIC_RAG_MYSQL_DSN=mysql+asyncmy://rag:rag@127.0.0.1:3306/agentic_rag?charset=utf8mb4
AGENTIC_RAG_REDIS_URL=redis://127.0.0.1:6379/0
AGENTIC_RAG_ELASTICSEARCH_URL=http://127.0.0.1:9200

AGENTIC_RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENTIC_RAG_DEEPSEEK_API_KEY=replace-with-deepseek-key
# auto prefers Chat Completions when both APIs are exposed; use responses only
# after validating the provider's Responses JSON mode.
AGENTIC_RAG_DEEPSEEK_PROTOCOL=auto
AGENTIC_RAG_QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTIC_RAG_QWEN_API_KEY=replace-with-qwen-key

# Mem0 is enabled by default. Explicit embedding values override Qwen fallback.
AGENTIC_RAG_MEM0_ENABLED=1
AGENTIC_RAG_MEM0_COLLECTION=agent_memories_v1
AGENTIC_RAG_MEM0_EMBEDDING_MODEL=text-embedding-v3
AGENTIC_RAG_MEM0_HISTORY_DB_PATH=var/mem0/history.db

AGENTIC_RAG_DEFAULT_USER_ID=default_user
AGENTIC_RAG_ALLOW_EVALUATION_REQUESTS=false
AGENTIC_RAG_INDEX_GENERATION=index-v3
# After installing matching IK and migrating, set INDEX_GENERATION=index-v4
# together with LEXICAL_ANALYSIS=ik. Existing indices stay on standard.
AGENTIC_RAG_LEXICAL_ANALYSIS=standard
AGENTIC_RAG_MAX_RESEARCH_ROUNDS=6

# Shared native/MCP runtime. MCP credentials belong only in the local env file
# or a deployment secret store. AMap is opt-in; native tools remain available.
AGENTIC_RAG_TOOL_RUNTIME_ENABLED=true
AGENTIC_RAG_TOOL_INVOCATION_PATH=var/tool_invocations.sqlite
AGENTIC_RAG_TOOL_MAX_CALLS_PER_RUN=12
AGENTIC_RAG_TOOL_MAX_DISCOVERIES_PER_RUN=4
AGENTIC_RAG_TOOL_CALL_TIMEOUT_SECONDS=20
AGENTIC_RAG_AMAP_MCP_ENABLED=false
AGENTIC_RAG_AMAP_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/amap-maps/sse
AGENTIC_RAG_AMAP_MCP_TRANSPORT=sse
DASHSCOPE_API_KEY=
# Other services: JSON array of enabled/id/url/transport/auth_type/
# credential_ref/allowed_tools/capabilities. See the unified-tool-runtime spec.
AGENTIC_RAG_MCP_SERVERS=[]
